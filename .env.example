# Configuration du bot Highrise Python

# API Token du bot
# Obtenir sur: https://create.highrise.game → Dashboard → Bots & API Keys
BOT_TOKEN=votre_token_api_ici

# ID de la room
# Obtenir via: App Highrise → Info room → Share this Room
ROOM_ID=votre_room_id_ici

# Usernames des administrateurs (séparés par des virgules)
# Plus simple que les IDs car les usernames sont uniques dans Highrise
# Exemple: ADMIN_USERNAMES=sylver_ralx_lm,autre_admin,encore_un_admin
ADMIN_USERNAMES=

# Clés API Gemini (Google AI Studio) - Rotation automatique toutes les 100 requêtes
# Obtenir sur: https://aistudio.google.com/app/apikey
# Vous pouvez ajouter jusqu'à 4 clés pour éviter les limites de taux
GEMINI_API_KEY=votre_cle_api_gemini_1_ici
GEMINI_API_KEY_2=votre_cle_api_gemini_2_ici
GEMINI_API_KEY_3=votre_cle_api_gemini_3_ici
GEMINI_API_KEY_4=votre_cle_api_gemini_4_ici
