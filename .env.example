# Configuration du bot Highrise Python

# API Token du bot
# Obtenir sur: https://create.highrise.game → Dashboard → Bots & API Keys
BOT_TOKEN=votre_token_api_ici

# ID de la room
# Obtenir via: App Highrise → Info room → Share this Room
ROOM_ID=votre_room_id_ici

# Usernames des administrateurs (séparés par des virgules)
# Plus simple que les IDs car les usernames sont uniques dans Highrise
# Exemple: ADMIN_USERNAMES=sylver_ralx_lm,autre_admin,encore_un_admin
ADMIN_USERNAMES=

# Clé API Gemini (Google AI Studio)
# Obtenir sur: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=votre_cle_api_gemini_ici My lya
